# Copy this file to .env and fill in real values.
# Never commit .env – it is in .gitignore.

# PostgreSQL connection string
DATABASE_URL=postgresql://crice:crice_dev@localhost:5432/crice

# Long random secret for signing session IDs cookie (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# Fernet key for encrypting TOTP secrets at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-fernet-key

# Session timeouts (seconds)
SESSION_IDLE_SECONDS=28800      # 8 hours idle timeout
SESSION_ABSOLUTE_SECONDS=86400  # 24 hours absolute timeout

# Set to true in production (requires HTTPS)
SECURE_COOKIES=false
