# Copy this file to .env and fill in real values.
# Never commit .env – it is in .gitignore.

# PostgreSQL connection string
DATABASE_URL=postgresql://crice:crice_dev@localhost:5432/crice

# Long random secret for signing session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# Separate secret for CSRF token derivation
CSRF_SECRET=replace-with-another-long-random-string-at-least-32-chars

# Session lifetime in seconds (default: 24 h)
SESSION_MAX_AGE=86400

# Set to true in production (requires HTTPS)
SECURE_COOKIES=false
